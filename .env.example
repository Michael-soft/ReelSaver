# ─── Core (required in production) ────────────────────────────────────────────
FLASK_ENV=production
SESSION_SECRET=change-me-to-a-long-random-string
SUPABASE_DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── Admin access (required for /api/command and /api/update-ytdlp) ────────────
# Comma-separated usernames or emails allowed to use admin-only endpoints.
ADMIN_USERS=admin@example.com

# ─── CORS (recommended) ───────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=https://your-frontend-domain.com

# ─── Google OAuth (optional — only if using "Continue with Google") ───────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ─── Rate limiting (recommended for multi-worker deployments) ─────────────────
# Use Redis so limits are shared across gunicorn workers. Defaults to memory://.
RATELIMIT_STORAGE_URI=redis://redis:6379/0

# ─── Storage paths (optional overrides) ───────────────────────────────────────
# DOWNLOADS_DIR=/data/downloads
# COOKIES_DIR=/data/cookies
# FRONTEND_DIST=/app/frontend/dist

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8000
